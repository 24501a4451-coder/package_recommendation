# Gemini AI API Key (server-side multimodal reasoning, vision perception, dynamic farmer voice dialog)
GEMINI_API_KEY=

# Server Port (defaults to 3000 in AI Studio)
PORT=3000

# Application Base URL (used for QR code verification URLs)
APP_URL=http://localhost:3000

# Optional Image Generation Flag
ENABLE_GEMINI_IMAGE_GENERATION=false

# Optional External Voice/Model Endpoints (Simulated fallback automatically engaged when omitted)
WHISPER_ENDPOINT=
WHISPER_API_KEY=
TTS_ENDPOINT=
OPEN_IMAGE_MODEL_ENDPOINT=
OPEN_IMAGE_MODEL_KEY=
OPEN_IMAGE_MODEL_NAME=
