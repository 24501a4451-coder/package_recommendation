# FOODPACK-AI Environment Configuration Example

# Gemini API Key (Server-side AI perception, assistant, farmer voice, image generation)
GEMINI_API_KEY=

# Server Port (AI Studio runs on port 3000)
PORT=3000

# Base URL for public verification QR codes
APP_URL=http://localhost:3000

# (Optional) External Whisper STT endpoint for audio transcription
WHISPER_ENDPOINT=
